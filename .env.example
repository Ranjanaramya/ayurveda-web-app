# ==============================================================================
# AYURVEDA CARE HOSPITAL - ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Next.js Application URL
APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Sanity Studio CMS Configuration
# ------------------------------------------------------------------------------
# Set NEXT_PUBLIC_SANITY_PROJECT_ID to your active Sanity Project ID.
# If unconfigured or set to "mock-id", the application automatically falls back to
# the built-in mock database (localStorage persistence & mock dataset).
NEXT_PUBLIC_SANITY_PROJECT_ID="mock-id"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2026-07-20"

# Optional: Sanity API Write Token (Required for server-side mutations/reviews writing)
SANITY_API_WRITE_TOKEN=""

# Optional: Secret token for trigger-based on-demand revalidation (/api/revalidate)
REVALIDATE_SECRET="ayurveda_secret_token"
